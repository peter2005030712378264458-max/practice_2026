# Track only the restored application bundle.
*
!.gitignore
!/*.*
!/LICENSE
!/version
!/launchers/
!/launchers/**
!/locales/
!/locales/**
!/resources/
!/resources/**

# Do not track large packaged executables.
/*.exe
# Do not track Node dependencies.
**/node_modules/
**/node_modules/**
# Do not track local model files.
resources/llm/*
!resources/llm/.gitkeep
resources/whisper/*
!resources/whisper/.gitkeep

# Runtime/local noise from the app.
*.log
**/*.log
**/*.tmp
**/logs/
**/cache/
# Optional local Qwen3-TTS models and generated audio
resources/tts/models/*
!resources/tts/models/.gitkeep
resources/tts/output/
resources/tts/venv/
resources/tts/*.wav
resources/tts/*_input.txt
resources/tts/*_output.wav
resources/tts/test_*.py
resources/tts/__pycache__/
resources/tts/**/__pycache__/
