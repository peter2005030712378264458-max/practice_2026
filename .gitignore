# Track only the restored application bundle.
*
!.gitignore
!/*.*
!/LICENSE
!/version
!/launchers/
!/launchers/**
!/locales/
!/locales/**
!/resources/
!/resources/**

# Do not track large packaged executables.
/*.exe
# Do not track Node dependencies.
**/node_modules/
**/node_modules/**
# Do not track local model files.
resources/llm/*
!resources/llm/.gitkeep
resources/whisper/*
!resources/whisper/.gitkeep

# Runtime/local noise from the app.
*.log
**/*.log
**/*.tmp
**/logs/
**/cache/
